---
interface Props {
  title: string
}
const { title } = Astro.props
---

<section class='home-section'>
  <h2>{title}</h2>
  <div class='home-section-content'><slot /></div>
</section>

<style>
  .home-section {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 40px;
    padding-block: 40px;
    border-top: 1px solid hsl(var(--border));
  }
  h2 {
    padding-top: 3px;
    font-size: 13px;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
  }
  .home-section-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }
  @media (max-width: 720px) {
    .home-section {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      padding-block: 30px;
    }
    .home-section-content {
      gap: 20px;
    }
  }
</style>
