---
interface Props {
  title: string
  skills: string[]
}
const { title, skills } = Astro.props
---

<div class='skill-row'>
  <h3>{title}</h3>
  <ul>{skills.map((skill) => <li>{skill}</li>)}</ul>
</div>

<style>
  .skill-row {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: 20px;
    font-size: 14px;
    line-height: 1.8;
  }
  h3 {
    font-weight: 500;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    column-gap: 20px;
    row-gap: 6px;
    color: hsl(var(--muted-foreground));
  }
  @media (max-width: 640px) {
    .skill-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
  }
</style>
