---
import type { MarkdownHeading, MarkdownLayoutProps } from 'astro'
import config from 'virtual:config'

import PageLayout from '@/layouts/BaseLayout.astro'

type Props = MarkdownLayoutProps<{
  title: string
  description: string
  heroImage?: { src: string }
  language?: string
  back?: string
}> & {
  headings: MarkdownHeading[]
}

const { frontmatter, headings } = Astro.props
const { title, description, heroImage, language, back } = frontmatter
const socialImage = heroImage?.src ?? config.socialCard
---

<PageLayout editorial meta={{ title, description, ogImage: socialImage }}>
  <main class='policy-page' id='page-top'>
    <header class='policy-heading'>
      <a class='policy-back' href={back ?? '/'}>← Back</a>
      <h1>{title}</h1>
      {description && <p class='policy-description'>{description}</p>}
      {language && <p class='policy-language'>{language}</p>}
    </header>

    {
      headings.length > 0 && (
        <nav class='policy-sections' aria-label='Page sections'>
          {headings.map(({ slug, text }) => (
            <a href={`#${slug}`}>{text}</a>
          ))}
        </nav>
      )
    }

    <article class='policy-prose'><slot /></article>

    <footer class='policy-footer'>
      <a href='/terms'>Site Policy</a>
      <a href='#page-top'>Back to top ↑</a>
    </footer>
  </main>
</PageLayout>

<style>
  .policy-page {
    max-width: 680px;
    margin-inline: auto;
    padding-bottom: 32px;
    scroll-margin-top: 100px;
    overflow-wrap: anywhere;
  }
  .policy-heading {
    padding: 80px 0 48px;
  }
  .policy-back {
    color: hsl(var(--muted-foreground));
    font-size: 13px;
  }
  h1 {
    margin-block: 24px;
    font-size: 48px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .policy-description {
    color: hsl(var(--muted-foreground));
    font-size: 17px;
    line-height: 1.8;
  }
  .policy-language {
    margin-top: 12px;
    color: hsl(var(--muted-foreground));
    font-size: 12px;
  }
  .policy-sections {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-bottom: 32px;
    padding-block: 20px;
    border-block: 1px solid hsl(var(--border) / 0.65);
    color: hsl(var(--muted-foreground));
    font-size: 13px;
  }
  .policy-prose {
    color: hsl(var(--article-text));
    font-size: 17px;
    line-height: 1.95;
  }
  .policy-prose :global(p) {
    margin-block: 1.5em;
  }
  .policy-prose > :global(:first-child) {
    margin-top: 0;
  }
  .policy-prose :global(:is(h2, h3, h4)) {
    margin-block: 2em 0.8em;
    color: hsl(var(--foreground));
    font-weight: 600;
    line-height: 1.5;
    scroll-margin-top: 100px;
  }
  .policy-prose :global(h2) {
    font-size: 26px;
  }
  .policy-prose :global(h3) {
    font-size: 21px;
  }
  .policy-prose :global(ul) {
    padding-left: 1.5em;
    list-style: disc;
  }
  .policy-prose :global(ol) {
    padding-left: 1.5em;
    list-style: decimal;
  }
  .policy-prose :global(li + li) {
    margin-top: 8px;
  }
  .policy-prose :global(a) {
    text-decoration: underline;
    text-decoration-color: hsl(var(--border));
    text-underline-offset: 5px;
  }
  .policy-page a:hover,
  .policy-prose :global(a:hover) {
    color: hsl(var(--primary));
  }
  .policy-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 20px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid hsl(var(--border) / 0.65);
    color: hsl(var(--muted-foreground));
    font-size: 12px;
  }
  @media (max-width: 640px) {
    .policy-heading {
      padding: 48px 0 36px;
    }
    h1 {
      font-size: 38px;
    }
    .policy-description,
    .policy-prose {
      font-size: 15px;
    }
    .policy-prose :global(h2) {
      font-size: 23px;
    }
    .policy-prose :global(h3) {
      font-size: 19px;
    }
  }
</style>
