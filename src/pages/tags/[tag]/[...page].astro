---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { getBlogCollection, getUniqueTags, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/EditorialPage.astro'
import EditorialPostItem from '@/components/EditorialPostItem.astro'
import config from '@/site-config'

export const prerender = true

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getBlogCollection()
  const allPostsByDate = sortMDByDate(allPosts)
  const uniqueTags = getUniqueTags(allPostsByDate)

  return uniqueTags.flatMap((tag) => {
    const filterPosts = allPostsByDate.filter((post) => post.data.tags.includes(tag))
    return paginate(filterPosts, {
      pageSize: config.content.blogPageSize,
      params: { tag }
    })
  })
}

interface Props {
  page: Page<CollectionEntry<'blog'>>
}

const { page } = Astro.props
const { tag } = Astro.params
const description = `View all posts with the tag - ${tag}`
---

<PageLayout title={`#${tag}`} eyebrow='Topic' {description}>
  <Fragment slot='intro'>
    <p>{page.total} post{page.total === 1 ? '' : 's'} collected under this topic.</p>
  </Fragment>
  <Fragment slot='actions'>
    <a href='/tags'>← All topics</a>
    <a href='/blog'>All posts →</a>
    <a href='/search'>Search ↗</a>
  </Fragment>

  <section aria-label={`Posts tagged ${tag}`}>
    <div class='topic-list-heading'>
      <span>Newest first</span>
      <span>Page {page.currentPage} of {page.lastPage}</span>
    </div>
    <ul class='topic-posts'>
      {page.data.map((post) => <EditorialPostItem {post} />)}
    </ul>
    {
      (page.url.prev || page.url.next) && (
        <nav class='topic-pagination' aria-label='Post pagination'>
          {page.url.prev && (
            <a href={page.url.prev} rel='prev'>
              ← Previous posts
            </a>
          )}
          {page.url.next && (
            <a class='next-page' href={page.url.next} rel='next'>
              Next posts →
            </a>
          )}
        </nav>
      )
    }
  </section>
</PageLayout>

<style>
  .topic-list-heading {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid hsl(var(--border));
    font-size: 12px;
    color: hsl(var(--muted-foreground));
  }
  .topic-posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .topic-pagination {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 28px;
    font-size: 13px;
  }
  .topic-pagination a {
    padding-block: 10px;
  }
  .next-page {
    margin-left: auto;
  }
</style>
